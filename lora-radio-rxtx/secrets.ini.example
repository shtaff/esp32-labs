; Copy to secrets.ini and fill in. secrets.ini is gitignored.
;
; Both sections matter for keeping this repo publishable:
;   [wifi]  credentials for the transmitter's NTP sync
;   [site]  the transmitter's real coordinate. It is no longer sent over the
;           air, and it should not be committed either - it is the location of
;           a piece of your equipment.
;
; Leaving [site] at 0,0 makes every distance_m and bearing_deg in the log
; meaningless. Both boards say so loudly at boot rather than letting it slide.

[wifi]
ssid = MyNetwork
password = MySecret

[site]
lat = 51.5074
lon = -0.1278
