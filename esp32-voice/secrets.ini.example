; Copy to secrets.ini and fill in. secrets.ini is gitignored.
;
; [voice] key is the 128-bit AES key, 32 hex characters, shared by both
; handsets. Generate one with:
;
;   openssl rand -hex 16
;   python -c "import os;print(os.urandom(16).hex())"
;
; This is a lab rig and the key is a build-time constant baked into the image:
; anyone with the flash contents has the key, and there is no key exchange, no
; forward secrecy and no message authentication. It keeps a casual listener
; with an SDR from hearing the conversation. That is all it is for.
;
; Leaving the key all-zero is the "not configured" sentinel. The firmware still
; boots and still talks in clear, but it refuses to arm encryption and says so.

[voice]
key = 000102030405060708090a0b0c0d0e0f
